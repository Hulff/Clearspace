import { Button, LineEdit, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct TreeRow {
    id: int,
    depth: int,
    name: string,
    size: string,
    risk: string,
    risk-color: color,
    indent: int,
    expanded: bool,
    expandable: bool,
    checked: bool,
    kind: int,
}

export component MainWindow inherits Window {
    title: "Clearspace toolkit spike";
    width: 1000px;
    height: 760px;
    background: #181a1b;
    in-out property <[TreeRow]> rows;
    in-out property <string> selection-summary: "0 items selected - 0.0 GiB";
    callback toggle-expand(int);
    callback toggle-select(int);
    callback show-more(int);

    VerticalBox {
        padding: 16px;
        spacing: 8px;
        Text { text: "Clearspace toolkit spike"; color: #eceeef; font-size: 22px; }
        HorizontalBox {
            spacing: 0px;
            Text { text: "□"; width: 44px; color: #eceeef; }
            Text { text: "Name"; horizontal-stretch: 4; color: #eceeef; }
            Text { text: "Usage"; width: 120px; color: #eceeef; }
            Text { text: "Size"; width: 100px; color: #eceeef; }
            Text { text: "Risk"; width: 110px; color: #eceeef; }
        }
        ListView {
            for row[index] in root.rows: Rectangle {
                height: 30px;
                background: #232627;
                HorizontalBox {
                    spacing: 8px;
                    Rectangle { width: row.indent * 1px; background: transparent; }
                    Button {
                        width: 34px;
                        text: row.checked ? "☑" : "☐";
                        enabled: row.kind == 0;
                        clicked => { root.toggle-select(row.id); }
                    }
                    Button {
                        horizontal-stretch: 4;
                        text: (row.expandable ? (row.expanded ? "▾ " : "▸ ") : "  ") + row.name;
                        clicked => {
                            if (row.kind == 2) { root.show-more(row.id); }
                            else if (row.expandable) { root.toggle-expand(row.id); }
                        }
                    }
                    Rectangle { width: 120px; height: 10px; background: #34383a;
                        Rectangle { x: 0px; y: 0px; height: 10px; width: 60px; background: #5aa9ff; }
                    }
                    Text { width: 100px; text: row.size; color: #eceeef; }
                    Text { width: 110px; text: row.risk; color: row.risk-color; }
                }
            }
        }
        HorizontalBox {
            Text { text: root.selection-summary; color: #eceeef; horizontal-stretch: 1; }
            LineEdit { placeholder-text: "Ask about this folder…"; width: 300px; }
        }
    }
}
